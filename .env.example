# ── Required (unchanged from V2/V3) ─────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require   # Neon: use the pooled (-pooler) string
AUTH_SECRET=replace-with-a-long-random-string                       # e.g. openssl rand -base64 48

# ── Optional (existing) ─────────────────────────────────────────────────────
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=4
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── JARVIS AI (server-only; omit to use rule-based commands only) ───────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=20000

# ── V4 Redis cache (all optional, all SERVER-ONLY — never prefix with NEXT_PUBLIC_) ──
# Upstash Redis REST credentials: console.upstash.com → your database → "REST API" section. Without these the cache is simply OFF.
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# CACHE_DISABLED=1            # kill switch: turns the cache off without removing the credentials
# CACHE_TIMEOUT_MS=800        # per-request Redis timeout before falling back to the database
# CACHE_BREAKER_BASE_MS=30000 # how long to stop calling Redis after it fails / hits quota (doubles up to 5 min)
# CACHE_DEBUG=1               # log cache hits/misses (always on in development)
# DASHBOARD_CACHE=0           # turn off ONLY the dashboard-data cache (JARVIS answer caching stays on)
