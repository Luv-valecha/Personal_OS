{
  "name": "personal-dashboard",
  "version": "3.1.21",
  "private": true,
  "description": "Lucifer's personal operating system \u2014 Next.js + PostgreSQL PWA (JavaScript only)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:check": "node scripts/check-db.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --experimental-default-type=module --import ./tests/register.mjs --test tests/unit/*.test.mjs",
    "mock:gemini": "node tests/mock-gemini.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^18.0.5",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
